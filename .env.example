# Copiar a .env y completar. No subir .env al repositorio.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
TRUSTED_PROXY_HOPS=1

# Base de datos (PostgreSQL)
DATABASE_URL=
DB_SSL=true
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=20

# JWT y criptografía
JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=12

# Políticas de seguridad
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=1
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Secreto para firmar (HMAC) los OTP de 6 dígitos. Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_SECRET=

# Correo (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="CofflyFlow <correo@dominio.com>"

# Frontend y cookies de sesión
WEB_URL=http://localhost:3000
# lax en local; en producción con web y API en dominios distintos: none (requiere COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Primer usuario OWNER (solo para: npm run seed:owner)
# OWNER_EMAIL=
# OWNER_NAME=
# OWNER_PASSWORD=
