# Copiar a .env y completar. No subir .env al repositorio.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Proxies de confianza delante de la API: 0 = conexiones directas; 1 = un proxy (Next rewrite o balanceador); 2 = Railway + Next
TRUSTED_PROXY_HOPS=1

# Base de datos (PostgreSQL)
DATABASE_URL=
DB_SSL=true
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=20

# JWT y criptografía
JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=12
# Tope absoluto de una sesión desde que se inicia sesión (horas): una jornada laboral. Pasado el tope hay que volver a ingresar.
SESSION_MAX_HOURS=8
# Minutos sin actividad del usuario (clics, teclas, toques) tras los cuales la sesión se cierra sola.
SESSION_IDLE_MINUTES=5
# Clave para cifrar DNI y teléfono del personal (AES-256-GCM). Opcional: si falta, se deriva de JWT_SECRET.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))". NO cambiarla después de guardar datos.
PII_ENCRYPTION_KEY=

# Políticas de seguridad
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=1
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Secreto para firmar (HMAC) los OTP de 6 dígitos. Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_SECRET=

# Correo (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="CofflyFlow <correo@dominio.com>"

# Frontend y cookies de sesión
WEB_URL=http://localhost:3000
# lax en local; en producción con web y API en dominios distintos: none (requiere COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Primer usuario OWNER (solo para: npm run seed:owner)
# OWNER_EMAIL=
# OWNER_NAME=
# OWNER_PASSWORD=

# Observabilidad / APM (opcional, servicio de terceros: https://observe.nestjs.com)
# Crea un servicio allí para obtener la clave y el secreto. Sin ambas variables el APM queda APAGADO (no sale ningún dato).
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
# OBSERVE_SERVICE_ID=cofflyflow-api
# OBSERVE_SERVICE_VERSION=1.0.0
# Porcentaje de trazas a enviar, de 0 a 1 (recomendado 0.2 en producción con mucho tráfico)
# OBSERVE_TRACES_SAMPLE_RATE=1

# Redis (opcional pero RECOMENDADO en producción con más de una instancia)
# Comparte entre instancias los límites de peticiones, los intentos de login y los eventos WebSocket del KDS.
# Sin esta variable todo ese estado vive en memoria de cada instancia.
# REDIS_URL=redis://localhost:6379
